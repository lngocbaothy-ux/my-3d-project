const LORE={};
function lore(id,o){LORE[id]=Object.assign({id},o);return LORE[id];}
const BIOME_TXT={
 gremvang:['Biome — Cultivated Rye Plain','Hvel','The breadbasket of the Wheel: chest-high rye around the hamlet of Kraghaven. The grain hisses and whispers even when no wind is blowing.','Harvest only by daylight. Scarecrows are set facing outward, away from the village. At dusk, faceless figures stand at the field edges and simply watch.','Walk the furrows, never the margins. Never meet the gaze of a figure at the field\'s edge for longer than a breath.'],
 kjolmyr:['Biome — Cold Peat Mire','Hvel','A drowned moor of black peat and grey standing water, cupped between the dikes of the north. The fog here is the colour of wet ash, not of cloud.','If the fog turns grey rather than white, stop speaking. The Murk hunts by breath and follows any who wander the mire.','Keep moving; sprint for the dikes. The Murk will not cross dike stone nor leave the mire. A sword stroke scatters it for a few heartbeats.'],
 hrimmark:['Biome — Frost Moor','Hvel','Hoarfrost lies on the heather in every season. Frost-heaved stones hide nests of Kvernlings, fist-sized and many-legged.','Never sleep on bare ground. The frost creaks in a rhythm that is not your footsteps.','Stamp as you walk; one sword blow kills a Kvernling, and sweeps knock a pack back. Do not stand still.'],
 valen:['Biome — Green Meadow','Aethe','The gentlest-looking land of the Wheel: soft meadows and heather in rounded clumps. Some of the clumps are Mawbriar.','A bush that does not sway in the wind is not a bush. Mawbriar wait until you are within a few paces.','Strike from sword reach or shoot from afar. Walk where the grass is cropped short.'],
 kessaren:['Biome — Reedbed & Broken Causeway','Aethe','Brown reed-marsh crossed by drowned causeways of the first settlers. Voices in the reeds call your name in your mother\'s accent.','Never answer a voice in the reeds in your own tongue.','Answer only in Aethe, or not at all. Carry salt; pour a line of it across the causeway behind you.'],
 thalenis:['Biome — Grey Shingle Shore','Aethe','The flat, pebbled outflow plain of the Rhoenos where it reaches the West Gate. Bells of a drowned chapel ring under the shingle.','Count the bells. Twelve is weather. Thirteen is something else.','If you count thirteen, leave by the West Gate before the fourteenth.'],
 dvelskarn:['Biome — Slate Quarry Gorges','Hvel','Terraced slate pits cut by the young Rhoenos after it leaves the glacier. The miners\' camp Skarnhold stands empty, tools still on their hooks.','Tools left underground must never be retrieved. The quarries echo with picks at night.','Travel the river by sampan; stay out of the cut terraces after dusk.'],
 nyrkvold:['Biome — Black Pine Forest','Hvel','A forest of blackpines that grow a hand\'s-breadth each night. The canopy is much too high, and something higher still stands among the trunks.','NEVER LOOK UP AT NIGHT. The Tall One exists only above eye-level after dark.','Keep your eyes on your boots and walk by the sound of the stream. Leave the forest before dusk.'],
 hjarnvang:['Biome — Cairn Heath','Hvel','Grey heath studded with cairns no one remembers building. There is one more cairn every morning.','Do not add a stone. Do not topple a stone. Do not count them aloud.','If you find a cairn in your own camp, break camp at once and walk downhill.'],
 sarrobren:['Biome — Ochre Scrubland','Aethe','Dry, ochre gullies and thornscrub. Kvernling swarms boil from the gullies at the smell of sweat.','Swarms emerge whenever someone lingers; they are fastest in the evening heat.','Move by day and keep your blade drawn. Fight with your back to a slope so they cannot surround you.'],
 halorren:['Biome — Salt Flats','Aethe','A mirror-flat white pan. A mirage of a second traveller walks parallel to you, a little ahead, wearing your clothes.','Never wave back at the walker in the salt.','Keep your eyes on the horizon, not the mirage; cross at noon when it is weakest.'],
 nerith:['Biome — Wet Fen','Aethe','Where the Rhoenos slows after breaking through the West Dike Gap: reed islands, black pools and moored sampans. Mawbriar grow along the banks.','Banks are where the Mawbriar wait. Water is safer than land here.','Board a sampan [F] and travel by river. Keep to the middle of the channel.'],
 hveskgruv:['Biome — Glacier','Hvel / Ketha border','The great glacier on the inner slope. From its ice cave the Rhoenos is born. The cave exhales warm air that smells of breath.','Do not go deeper into the cave than daylight reaches. The warm air is breathing out; one day it will breathe in.','Follow the meltwater out, never in. Leave offerings of iron nails at the mouth.'],
 iskhjarn:['Biome — Serac Field (The Ice-Brain)','Hvel / Ketha border','Ridged seracs that groan in long, patterned tones the Hvel call speech. Pilgrims have transcribed it; their notes all end mid-sentence.','Listening too long makes you understand it.','Stop your ears with wax. Cross between seracs only in pairs, one watching the other.'],
 'thaal-uresh':['Biome — Basalt & Lava Vents','Ketha','The still-warm wound of the magma dome: black basalt plates, red fissures and sulphur vents.','The crust is thin where it is quiet. The ground hums before it opens.','Probe ahead with a spear-butt or the bow. Walk on the dark plates, never on the grey ash between.'],
 'vaar-ithun':['Biome — Violet Ash Slopes','Ketha','Slopes of violet volcanic ash. At dawn the ash falls upward toward Ithuun.','Do not breathe the ash that rises. It returns to the crater and takes what it carries.','Cloth over mouth. Lie flat at dawn until the upward fall has passed.'],
 kaurath:['Biome — Rust Iron Scree','Ketha','Rust-red iron scree where compasses spin. Ruined war-camps of the Ketha lie in rings.','Iron weapons grow heavy here, as if they want to stay.','Navigate by the dikes, not by needle. Do not drop your sword; you will not lift it again.'],
 'ur-keth':['Biome — Bone Plateau','Ketha','A bone-pale plateau of fossil ossuaries, the "First City" of the Ketha, laid out in the shape of an eye.','What is buried here is not yours, and it remembers being alive.','Take nothing. Leave by the same path you entered, walking backwards for the first hundred paces.'],
 ithuun:['Caldera — Cosmic Anomaly','Ketha (no human tongue reaches the floor)','The collapsed heart of the magma dome. An obsidian crater floor, and above it a sphere of absent light that the Ketha call the Unlidded Eye.','Time runs slow at the rim and not at all on the floor. Nothing that descends comes back the same height.','None known. Turn back at the rim.'],
 outlands:['Region — Moorland & Star Wings','Hvel / pre-Hvel','The open moor outside the Fault Wall, crossed by the six menhir wings of the Star.','The menhirs lean a finger-width toward whoever walks between them at night.','Walk the outside of a wing, never between two rows.']
};
const MARGIN_TXT=['The air smells of a school corridor after everyone has gone home.','The light comes from no sun; there are no shadows on the fence.','You can hear a swimming pool, echoing, very far away.','The grass is soft and short like carpet. It is slightly warm.','You remember a house you have never lived in, and want to go home to it.','The fence has a gate. It only opens inward.','No one has come back to describe Lề VII.'];
for(const id in BIOME_DEF){const d=BIOME_DEF[id];
  if(d.props==='margin'){const m=d.m||8;lore(id,{name:d.name+(m<8?' — Elvaren Margin':''),cls:'Liminal Margin — Elvaren Dreamcore Fence',ring:'Outer Margins · band '+(m<8?ROMAN[m-1]+' of VII':'beyond VII'),lang:'None — Elvaren (words do not carry here)',
    desc:'Seven pastel fences ring the world beyond the Star. The Elvaren say they were not built, only noticed. Each margin is calmer, softer and more familiar than the last.',habits:MARGIN_TXT[Math.min(6,m-1)],counter:'Turn around while it still feels like a dream. If it begins to feel like home, you have gone one margin too far.',build:()=>B.fence(Math.min(7,m)),kind:'biome'});continue;}
  const t=BIOME_TXT[id];lore(id,{name:d.name,cls:t[0],ring:(RINGTXT[d.ring]||'')+(d.sector>=0?' · Sector '+ROMAN[d.sector]:''),lang:t[1],desc:t[2],habits:t[3],counter:t[4],build:()=>B.biome(id),kind:'biome'});}
lore('void',{name:'The White Beyond',cls:'Liminal Void',ring:'Beyond Lề VII',lang:'—',desc:'Where the land fades to white.',habits:'—',counter:'Do not.',build:()=>B.fence(7)});
lore('dike',{name:'Nan Hoa — The Six Radial Dikes',cls:'Geological Dike / Ancient Masonry',ring:'Inner → Outer Ring · sector boundaries',lang:'Hvel "Nanstav" · Ketha "Ur-veth"',
  desc:'When the magma dome collapsed, six radial fractures filled with basalt, standing proud like the spokes (nan hoa) of a wheel. Generations dressed them with stone. They divide the Wheel into six sectors.',
  habits:'Nothing that crawls crosses dike stone: Kvernlings and the Murk turn back at the basalt. Passes exist only where the rings meet, and where the Rhoenos broke through the West Dike.',
  counter:'Sleep with your back to a dike. If chased, find a ring-pass and put the stone between you and it.',build:B.dikeChunk});
lore('faultwall',{name:'Vòng Thành — Outer Ring Fault Wall',cls:'Ring Fault Scarp / Fortification',ring:'Outer Ring boundary (≈ r 900)',lang:'Hvel / Aethe',
  desc:'The ring fault where the skirt of the dome sheared away — a natural cliff later crowned with merlons. Six gates pierce it, each facing one apex of the Star.',
  habits:'The wall keeps things in, not out. Watchers say the merlons are counted every dawn and one is always missing.',counter:'Enter and leave only by the gates. Never climb.',build:B.wallChunk});
const MONO=[{id:'morgunstav',name:'Morgunstav / Heosine',a:0,color:0xffc98a,lang:'Hvel "Morning-staff" · Aethe "Heosine"',t:'The dawn apex. Its amber rune-rings light a moment before sunrise, every day, even under cloud.',h:'Travellers who touch it at dawn forget one night of their lives — always a bad one.',c:'Arrive after sunrise. Shade your eyes from the top-stone.'},
 {id:'pyrrhene',name:'Pyrrhene',a:60,color:0xff5a3a,lang:'Aethe',t:'The fire apex. Warm to the touch in winter; the grass around it never frosts.',h:'Birds that land on it fall asleep and do not wake.',c:'Rest near it on cold nights, but never against it.'},
 {id:'nephiren',name:'Nephiren',a:120,color:0x9fb8ff,lang:'Aethe',t:'The cloud apex. Mist pours from its crown like water from a spring and flows downhill toward Gremvang.',h:'The mist carries voices from the rye-fields.',c:'Walk upwind of its mist.'},
 {id:'kveldstav',name:'Kveldstav / Hesperon',a:180,color:0xd08aff,lang:'Hvel "Evening-staff" · Aethe "Hesperon"',t:'The evening apex of the West Star Wing, beside which the Rhoenos leaves the world.',h:'Its shadow points east at sunset, toward Ithuun, regardless of where the sun is.',c:'Follow the river, not the shadow.'},
 {id:'kaldstav',name:'Kaldstav',a:240,color:0xbff0ff,lang:'Hvel "Cold-staff"',t:'The cold apex. Frost grows on it in high summer, spelling words in a script no one reads.',h:'Reading the frost makes your fingers numb for a day.',c:'Do not trace the frost-letters with a finger.'},
 {id:'ravnstav',name:'Ravnstav',a:300,color:0x8a8aa8,lang:'Hvel "Raven-staff"',t:'The raven apex. Ravens circle it constantly but never land.',h:'If a raven lands, someone in the Wheel has just died.',c:'Count the ravens before you pass. If one is missing, take the long way.'}];
MONO.forEach((m,k)=>{lore(m.id,{name:m.name,cls:'Apex Monolith of the Six-Pointed Star',ring:'Beyond the Fault Wall · Star apex '+ROMAN[k],lang:m.lang,desc:m.t,habits:m.h,counter:m.c,build:()=>B.monolith(m),kind:'landmark'});
  lore('gate-'+k,{name:'Cổng '+m.name.split(' /')[0].replace('stav','')+' — Gate '+ROMAN[k],cls:'Gatehouse of the Fault Wall',ring:'Outer Ring Fault Wall · facing '+m.name,lang:m.lang,
   desc:'One of six gates through the Vòng Thành, aligned on the menhir wing that runs out to '+m.name+'. The towers are older than the wall itself.',habits:'The gate remembers faces. Those who look back while passing beneath the lintel find it closed when they return.',counter:'Pass through without looking back. Touch the lintel stone with iron.',build:()=>B.gate(m),kind:'landmark'});});
lore('menhir',{name:'Star Menhirs — Hàng Đá Dựng',cls:'Megalithic Alignment',ring:'Beyond the Fault Wall · Six Star Wings',lang:'pre-Hvel',desc:'Hundreds of standing stones trace a six-pointed star around the Wheel. Only the wings outside the wall still stand; inside, they were broken to build the dikes.',
  habits:'The stones lean a finger-width toward whoever walks between them at night.',counter:'Walk the outside of a wing, never between two rows.',build:B.menhir});
lore('rhoenos',{name:'Sông Rhoenos — The Rhoenos River',cls:'River',ring:'Inner → Middle → Outer → West Star Wing',lang:'Aethe "Rhoenos" · Hvel "Rønå"',
  desc:'Born in the Hveskgruv glacier cave, it cuts the slate of Dvelskarn, slips through the West Dike Gap into the fen of Nerith, leaves by the West Gate and follows the West Star Wing out of the world.',
  habits:'It flows faster at night and makes no sound at all after midnight. What swims in it does not like the taste of wood.',counter:'Travel by sampan [F]. Never drink at the West Dike Gap. Keep to the middle of the channel.',build:B.riverChunk});
lore('cave',{name:'Hang Băng Hveskgruv — Glacier Cave',cls:'Glacier Cave / River Source',ring:'Inner Ring · Sector I',lang:'Hvel / Ketha',desc:'An arch of blue ice from which the Rhoenos pours. Warm air breathes out of it in long, slow exhalations.',habits:'Light reaches thirty paces in. Beyond that, people report a staircase.',counter:'Do not take the stairs.',build:B.cave});
lore('singularity',{name:'Mắt Ithuun — The Unlidded Eye',cls:'Cosmic Anomaly',ring:'Central Caldera · Ithuun',lang:'Ketha — "the word before words"',desc:'A sphere of absent light hanging above the obsidian floor, girdled by a slow ring of pale fire. Every road in the Wheel slopes toward it.',habits:'It does not watch. It is the reason watching exists.',counter:'There is no countermeasure. Keep the rim between you and it.',build:B.singularity});
lore('sampan',{name:'Xuồng Gỗ — Rhoenos Sampan',cls:'Vessel — Flat-bottomed River Skiff',ring:'Rhoenos River (Dvelskarn → Nerith → Thalenis)',lang:'Aethe',desc:'Rustic plank skiffs with a woven bamboo canopy and a stern lantern, left moored for any traveller.',
  habits:'Custom: leave a sampan downstream of where you found it, and a coin under the canopy.',counter:'Press [F] near one to board, WASD to pole, [F] again to step ashore. Things in the water cannot climb onto a wooden hull.',build:B.sampan});
lore('kraghaven',{name:'Kraghaven',cls:'Settlement — Farming Hamlet',ring:'Outer Ring · Gremvang (Sector I)',lang:'Hvel',desc:'Seven turf-roofed houses around a well, ringed by rye. The people are kind, quiet, and keep the shutters closed.',
  habits:'Shutters close at dusk. Families sleep facing the wall, never the window. No one names the figures at the field edge.',counter:'Ask for bread, not shelter — they will give the first. Sanity recovers near the well.',build:()=>B.settlement(7)});
lore('skarnhold',{name:'Skarnhold',cls:'Settlement — Abandoned Quarry Camp',ring:'Middle Ring · Dvelskarn (Sector I)',lang:'Hvel',desc:'A miners\' camp emptied in a single night. Supper is still on the tables, petrified.',habits:'Doors here open on their own when you are not looking.',counter:'Do not sleep in Skarnhold. Do not eat the supper.',build:()=>B.settlement(5,0x4a4a50)});
lore('rhoenmouth',{name:'Rhoenmouth — Cửa Rhoenos',cls:'Settlement — Ferry Hamlet',ring:'Outer Ring · Thalenis (Sector VI)',lang:'Aethe',desc:'Ferrymen\'s houses by the West Gate where the Rhoenos leaves the Wheel.',habits:'The ferrymen will take you out of the Wheel for a coin. They have never taken anyone back in.',counter:'Pay after the crossing, never before.',build:()=>B.settlement(6,0x6a5440)});
lore('pine',{name:'Nyrkvøld Blackpine',cls:'Flora — Conifer',ring:'Middle Ring · Nyrkvøld, scattered elsewhere',lang:'Hvel',desc:'Near-black pines with resin that smells of candle smoke. They grow a hand\'s-breadth each night.',habits:'The forest is taller every morning, and so is what lives above it.',counter:'Chalk-mark trunks as you go; the marks will be higher on the way back, but they will be there.',build:B.pine});
lore('oak',{name:'Grey Gallows-Oak',cls:'Flora — Dead Hardwood',ring:'Outer Ring & Star Moors',lang:'Hvel',desc:'Leafless grey oaks that never rot. Old rope loops hang from many.',habits:'Ropes reappear on branches that were cut clean.',counter:'Do not camp beneath one. Do not cut the rope.',build:B.oak});
lore('rye',{name:'Kraghaven Rye',cls:'Flora — Cereal',ring:'Outer Ring · Gremvang',lang:'Hvel',desc:'Tall, pale-gold rye that whispers without wind.',habits:'The whispering is loudest at the field edges, where the Faceless Shadows stand.',counter:'Harvest by daylight only; leave the last sheaf standing.',build:B.rye});
lore('faceless',{name:'Bóng Người Không Mặt — The Faceless Shadow',cls:'Entity — Gaze-bound (Folk Horror)',ring:'Outer Ring · Gremvang — Kraghaven field edges',lang:'Hvel "Andlitslaus"',
  desc:'A tall, dark figure with a smooth, blank head, standing motionless where the rye meets the moor. It is always facing you.',
  habits:'It reacts to being observed. Hold your gaze on it for more than 2.5 seconds and the blank face splits: two glowing eyes, then an ear-to-ear grin of jagged teeth. It lurches closer, and as long as you keep looking, it drinks your sanity and your blood.',
  counter:'LOOK AWAY. Peripheral glances are safe. Iron passes through it harmlessly — a strike only makes it step somewhere else.',build:B.faceless,kind:'creature'});
lore('tall',{name:'Kẻ Cao Nyrkvøld — The Tall One',cls:'Entity — Vertical Apparition (Cosmic Horror)',ring:'Middle Ring · Nyrkvøld',lang:'Hvel "Høgvesen"',
  desc:'A figure twice the height of the blackpines, arms hanging to its knees. By day it is a dark shape among the trunks. By night it is only ever above you.',
  habits:'Triggers when you LOOK UP in Nyrkvøld at night: it is already there, bending over the canopy, and your mind empties into it.',counter:'Do not look up at night. Keep your eyes on the path; leave the forest before dusk.',build:B.tall,kind:'creature'});
lore('murk',{name:'The Murk — Sương Xám',cls:'Entity — Fog Predator',ring:'Outer Ring · Kjølmyr',lang:'Hvel "Myrkvi"',
  desc:'A heaving mass of grey fog with three pale points like eyes. When it is near, the fog of Kjølmyr thickens to ash-grey.',
  habits:'Chases anything that breathes inside the mire, a little slower than a sprint. It will not cross dike stone or leave Kjølmyr.',counter:'Sprint (Shift). A sword stroke scatters it for a few seconds. Arrows pass straight through.',build:B.murk,kind:'creature'});
lore('mawbriar',{name:'Mawbriar — Bụi Hàm (Carnivorous Flora)',cls:'Carnivorous Flora — Ambush Predator',ring:'Outer Valen & Kessaren · Middle Nerith',lang:'Aethe "Stomalis"',
  desc:'Indistinguishable from a heather bush until you are within a few paces — then its leaves peel back into a ring of red, toothed petals around a glistening maw.',
  habits:'Camouflaged and motionless until approached; lunges and bites anything within reach.',counter:'Three sword strikes or two arrows kill it. Bushes that do not sway in the wind should be given a wide berth.',build:B.mawbriar,kind:'creature'});
lore('kvernling',{name:'Kvernlings — Lũ Nhỏ Hung Tợn',cls:'Fauna — Swarm Vermin (Tiny Vicious Creatures)',ring:'Outer Hrimmark · Middle Sarrobren & Halorren',lang:'Hvel "Kvern" (grinder)',
  desc:'Fist-sized, six-legged, red-eyed things with grinding mandibles. They nest under stones in packs.',
  habits:'Swarm anything that comes near, faster than you can walk. Each bite is small; there are always many.',counter:'One blow or one arrow kills one. Sword knockback scatters the pack. They will not cross dike stone.',build:B.kvernling,kind:'creature'});

