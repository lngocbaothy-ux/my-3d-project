const pickables=[];
function reg(o,id){o.traverse(c=>{c.userData.loreId=id;});pickables.push(o);return o;}
function place(o,x,z,y=0){o.position.set(x,groundHeight(x,z)+y,z);scene.add(o);return o;}
let terrain,water,markers=new THREE.Group(),labelsOn=true;
const LABELS=[];
