    case 'scrub':R(()=>mesh(new THREE.IcosahedronGeometry(.3+Math.random()*.3,0),M(0x7a6a30,{flatShading:true}),0,.2,0),26);R(()=>B.kvernling(),5,3);break;
    case 'salt':R(()=>{const m=mesh(new THREE.OctahedronGeometry(.25+Math.random()*.3,0),M(0xffffff,{roughness:.2}),0,.25,0);m.scale.y=2;return m;},22);break;
    case 'fen':R(()=>{const m=mesh(new THREE.CircleGeometry(.6+Math.random()*.8,12),M(0x24403a,{metalness:.4,roughness:.2}),0,.02,0);m.rotation.x=-Math.PI/2;return m;},9);{const s=B.sampan();s.scale.setScalar(.6);s.position.set(1,0,1);g.add(s);const m=B.mawbriar();m.scale.setScalar(.7);m.position.set(-2.5,0,-1);g.add(m);}break;
    case 'glacier':R(()=>mesh(new THREE.BoxGeometry(.8+Math.random(),.6+Math.random()*1.4,.8+Math.random()),M(0xd8ecf8,{roughness:.2,flatShading:true}),0,.4,0),14);{const cv=B.cave();cv.scale.setScalar(.15);cv.position.set(0,0,-2);g.add(cv);}break;
    case 'seracs':R(()=>{const m=mesh(new THREE.ConeGeometry(.3+Math.random()*.3,1.5+Math.random()*2,5),M(0xbad6ea,{roughness:.2,flatShading:true}),0,.9,0);return m;},26);break;
