    else if(e.type==='maw'){if(!e.alive){e.dieT+=dt;e.g.scale.setScalar(Math.max(.01,1.6*(1-e.dieT)));if(e.dieT>1)e.g.visible=false;continue;}
      const target=dist<9?1:0;e.open+=(target-e.open)*Math.min(1,dt*6);e.g.userData.setOpen(e.open);
      if(e.open>.6)e.g.rotation.y=Math.atan2(player.pos.x-e.pos.x,player.pos.z-e.pos.z);
      e.bite-=dt;if(dist<3.4&&e.open>.8&&e.bite<=0){e.bite=.9;player.hp-=12;player.lastHit='A Mawbriar closed around you.';sfx('bite');document.getElementById('bloodv').style.opacity=.8;}}
    else if(e.type==='kvern'){if(!e.alive){e.dieT+=dt;e.g.rotation.z=Math.PI;if(e.dieT>1.5)e.g.visible=false;continue;}
      e.t+=dt;e.g.userData.anim(e.t);let tgt;const chase=dist<36&&mode==='fp';
      if(chase)tgt=player.pos;else tgt=e.home.clone().add(new THREE.Vector3(Math.sin(e.t*.7+e.r*10)*7,0,Math.cos(e.t*.5)*7));
      const v=tgt.clone().sub(e.pos).setY(0);const L=v.length();if(L>.8){v.normalize();const sp=chase?7.4:2;const np=e.pos.clone().addScaledVector(v,sp*dt).add(new THREE.Vector3(Math.sin(e.t*9)*.04,0,Math.cos(e.t*11)*.04));if(structAt(np.x,np.z).dike<.2){e.pos.x=np.x;e.pos.z=np.z;}e.g.rotation.y=Math.atan2(v.x,v.z);}
      e.pos.addScaledVector(e.vel,dt);e.vel.multiplyScalar(Math.exp(-5*dt));e.pos.y=groundHeight(e.pos.x,e.pos.z);
      e.bite-=dt;if(dist<1.1&&e.bite<=0){e.bite=1.1;player.hp-=2.5;player.lastHit='The Kvernlings stripped you.';sfx('bite');document.getElementById('bloodv').style.opacity=.5;}
      if(chase)terror=Math.max(terror,.12);}}
  singularity.userData.anim(clockT);
  // passive sanity
  const nearHome=player.pos.distanceTo(KRAG)<30||player.pos.distanceTo(LOREPOS.rhoenmouth)<30;
  if(terror<.05){if(nearHome)player.sanity+=5*dt;else if(!night)player.sanity+=1.2*dt;else player.sanity-=.35*dt;}
  if(player.sanity<=0){player.sanity=0;player.hp-=3*dt;player.lastHit=player.lastHit||'Your mind went out like a candle.';}
  player.sanity=Math.min(100,player.sanity);player.hp=Math.min(100,player.hp+(terror<.05&&nearHome?3*dt:0));
  if(player.hp<=0)die();}
const LOREPOS={};
function die(){if(dead)return;dead=true;player.hp=0;if(document.pointerLockElement)document.exitPointerLock();setTerror(0);
  document.getElementById('deathP').textContent=player.lastHit||'The Forbidden Land keeps what it takes.';document.getElementById('death').style.display='flex';}
document.getElementById('bRespawn').onclick=()=>{player.hp=100;player.sanity=100;player.stamina=100;exitFP();};

/* ---------------- map-mode idle animation ---------------- */
function idleAnim(dt){singularity.userData.anim(clockT);murkE.g.userData.anim(clockT);
  for(const e of enemies)if(e.type==='kvern'&&e.alive){e.t+=dt;e.g.userData.anim(e.t);}}

/* =====================================================================
   DAY / NIGHT / FOG
   ===================================================================== */
const SKY_DAY=new THREE.Color(0x8994a0),SKY_DUSK=new THREE.Color(0x4a3640),SKY_NIGHT=new THREE.Color(0x05060c),FOG_MIRE=new THREE.Color(0x76797c),tmpC=new THREE.Color();
function isNight(){return Math.sin(2*Math.PI*(dayT-.25))<-.05;}
function applyLighting(dt){const el=Math.sin(2*Math.PI*(dayT-.25));const sa=2*Math.PI*(dayT-.25);
  sun.position.set(Math.cos(sa)*1000,Math.sin(sa)*1000+80,400);sun.target.position.set(0,0,0);
  const dayK=smooth(-.15,.35,el);sun.intensity=.12+.85*dayK;sun.color.setHSL(.08,.6,.55+.25*dayK);hemi.intensity=.22+.45*dayK;
  if(el>.15)tmpC.copy(SKY_DUSK).lerp(SKY_DAY,smooth(.15,.5,el));else tmpC.copy(SKY_NIGHT).lerp(SKY_DUSK,smooth(-.2,.15,el));
  stars.material.opacity=1-smooth(-.25,.05,el);
  if(mode==='fp'){const mire=regionId==='kjolmyr';let near=40,far=mire?70:(isNight()?220:600);if(mire){near=2;}
    const fc=tmpC.clone();if(mire)fc.lerp(FOG_MIRE,isNight()?.35:.9);
    if(regionId==='nyrkvold'){fc.multiplyScalar(.6);far=Math.min(far,260);}
    scene.fog.color.lerp(fc,Math.min(1,dt*2));scene.fog.near+=(near-scene.fog.near)*Math.min(1,dt*1.5);scene.fog.far+=(far-scene.fog.far)*Math.min(1,dt*1.5);scene.background.copy(scene.fog.color);}
  else{scene.fog.color.copy(tmpC);scene.fog.near=2600;scene.fog.far=7500;scene.background.copy(tmpC);}}

/* =====================================================================
   HUD / HORROR FX
   ===================================================================== */
const fx=document.getElementById('fx'),fxc=fx.getContext('2d',{willReadFrequently:true}),scan=document.getElementById('scan'),vhs=document.getElementById('vhs');let terrorS=0,vhsClock=0;
function setTerror(t){terrorS=t;if(t<=.01){renderer.domElement.style.filter='';renderer.domElement.style.transform='';fx.style.opacity=0;scan.style.opacity=0;vhs.style.opacity=0;}}
function horrorFX(dt){terrorS+=(terror-terrorS)*Math.min(1,dt*(terror>terrorS?6:2));const t=terrorS;
  if(t<=.01){setTerror(0);}else{
    const j=t*t*14;renderer.domElement.style.transform=`translate(${(Math.random()-.5)*j}px,${(Math.random()-.5)*j*.4}px) skewX(${(Math.random()<t*.3?(Math.random()-.5)*t*6:0)}deg)`;
    const inv=t>.8&&Math.random()<.04;renderer.domElement.style.filter=`contrast(${1+t*.7}) saturate(${1-t*.7}) hue-rotate(${(Math.random()-.5)*t*70}deg)${inv?' invert(1)':''} brightness(${1-t*.15})`;
    fx.style.opacity=Math.min(.9,t*1.1);scan.style.opacity=t;vhs.style.opacity=t>.3?(Math.random()<.9?1:0):0;vhsClock+=dt;
    document.getElementById('vhsT').textContent=new Date(vhsClock*1000*37).toISOString().substr(11,8);
    fxc.clearRect(0,0,240,135);const bands=Math.floor(t*14);for(let i=0;i<bands;i++){const y=Math.random()*135,h=1+Math.random()*6*t;fxc.fillStyle=`rgba(${Math.random()<.5?'255,30,40':'40,230,255'},${.15+Math.random()*.35*t})`;fxc.fillRect((Math.random()-.5)*40*t,y,240,h);}
    const img=fxc.getImageData(0,0,240,135);const d=img.data;for(let i=0;i<d.length;i+=4){if(Math.random()<t*.18){const v=Math.random()*255;d[i]=d[i+1]=d[i+2]=v;d[i+3]=120*t;}}fxc.putImageData(img,0,0);}
  const san=player.sanity/100;document.getElementById('vignette').style.opacity=.3+(1-san)*.6+t*.3;
  const bv=document.getElementById('bloodv');bv.style.opacity=Math.max(0,parseFloat(bv.style.opacity||0)-dt*1.2)+(player.hp<30?.25:0);
  if(AC&&au.noise){const now=AC.currentTime;au.noise.gain.setTargetAtTime(t*.22,now,.05);au.shriek.gain.setTargetAtTime(t>.7?(t-.7)*.12:0,now,.04);au.shriekOsc.frequency.setTargetAtTime(500+Math.random()*500,now,.02);au.drone.gain.setTargetAtTime(.04+t*.05+(isNight()?.03:0),now,.3);}}
function updateHUD(){document.querySelector('#hp i').style.width=player.hp+'%';document.querySelector('#sn i').style.width=player.sanity+'%';document.querySelector('#st i').style.width=player.stamina+'%';
  const hh=Math.floor(dayT*24),mm=Math.floor((dayT*24%1)*60);document.getElementById('clock').textContent=`${String(hh).padStart(2,'0')}:${String(mm).padStart(2,'0')} ${isNight()?'☾ night':'☀ day'}`;
  const L=LORE[regionId];document.getElementById('regName').textContent=L?L.name.split(' —')[0]:'';document.getElementById('regSub').textContent=L?L.ring:'';
  let pr='';if(player.boat)pr='[W/S] pole the sampan · [F] step ashore';else if(nearestSampan())pr='[F] Board the sampan (Xuồng gỗ)';
  if(player.weapon===2&&player.drawing)pr='Drawing… '+Math.round(player.draw*100)+'%';document.getElementById('prompt').textContent=pr;
  const w=document.getElementById('warn');w.textContent=warnText;w.style.opacity=warnText?(Math.random()<.85?1:.2):0;w.style.transform=`translateX(calc(-50% + ${(Math.random()-.5)*terrorS*20}px))`;
  document.getElementById('cross').className=crossT>0?'hit':'';}
let fpPickT=0;function fpPick(dt){fpPickT+=dt;if(fpPickT<.12)return;fpPickT=0;const r=pickAt(new THREE.Vector2(0,0),140);fpTarget=r;const el=document.getElementById('fptag');
  if(r&&LORE[r.id]&&r.id!==regionId){el.innerHTML=LORE[r.id].name+' <small>[E] codex</small>';}else if(r&&LORE[r.id]){el.innerHTML='<small>'+LORE[r.id].name.split(' —')[0]+' · [E] codex</small>';}else el.innerHTML='';}

/* =====================================================================
   AUDIO (procedural)
   ===================================================================== */
let AC=null;const au={};
function initAudio(){if(AC)return;try{AC=new(window.AudioContext||window.webkitAudioContext)();}catch(e){return;}
  const master=AC.createGain();master.gain.value=.55;master.connect(AC.destination);au.master=master;
  const lp=AC.createBiquadFilter();lp.type='lowpass';lp.frequency.value=170;const dg=AC.createGain();dg.gain.value=.04;lp.connect(dg);dg.connect(master);au.drone=dg;
  [[41,'sawtooth'],[61.7,'sine'],[43.2,'triangle']].forEach(([f,t])=>{const o=AC.createOscillator();o.type=t;o.frequency.value=f;o.connect(lp);o.start();});
  const buf=AC.createBuffer(1,AC.sampleRate*2,AC.sampleRate),d=buf.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;au.buf=buf;
  const ns=AC.createBufferSource();ns.buffer=buf;ns.loop=true;const bp=AC.createBiquadFilter();bp.type='bandpass';bp.frequency.value=1700;bp.Q.value=.6;const ng=AC.createGain();ng.gain.value=0;ns.connect(bp);bp.connect(ng);ng.connect(master);ns.start();au.noise=ng;
  const s=AC.createOscillator();s.type='square';s.frequency.value=620;const sg=AC.createGain();sg.gain.value=0;s.connect(sg);sg.connect(master);s.start();au.shriek=sg;au.shriekOsc=s;}
function sfx(type){if(!AC)return;const t=AC.currentTime,g=AC.createGain();g.connect(au.master);
  if(type==='swing'||type==='bite'||type==='hit'){const src=AC.createBufferSource();src.buffer=au.buf;const f=AC.createBiquadFilter();f.type=type==='swing'?'bandpass':'lowpass';
    f.frequency.setValueAtTime(type==='swing'?500:type==='hit'?400:900,t);if(type==='swing')f.frequency.exponentialRampToValueAtTime(3200,t+.2);
    g.gain.setValueAtTime(type==='hit'?.6:.35,t);g.gain.exponentialRampToValueAtTime(.001,t+(type==='swing'?.25:.15));src.connect(f);f.connect(g);src.start(t,Math.random());src.stop(t+.3);}
  else if(type==='twang'){const o=AC.createOscillator();o.type='triangle';o.frequency.setValueAtTime(220,t);o.frequency.exponentialRampToValueAtTime(90,t+.25);g.gain.setValueAtTime(.3,t);g.gain.exponentialRampToValueAtTime(.001,t+.3);o.connect(g);o.start(t);o.stop(t+.32);}
  else if(type==='sting'){[233,247,370,523,554].forEach(fq=>{const o=AC.createOscillator();o.type='sawtooth';o.frequency.setValueAtTime(fq,t);o.frequency.linearRampToValueAtTime(fq*.94,t+1.6);o.connect(g);o.start(t);o.stop(t+1.7);});
    g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.12,t+.05);g.gain.exponentialRampToValueAtTime(.001,t+1.6);}}

/* =====================================================================
   UI BUTTONS / RESIZE
   ===================================================================== */
document.getElementById('bAtlas').onclick=()=>{tween={fp:camera.position.clone(),ft:controls.target.clone(),tp:new THREE.Vector3(0,1750,1550),tt:new THREE.Vector3(0,60,0),t:0,dur:1.4};};
document.getElementById('bDescend').onclick=()=>{initAudio();savedMap={p:camera.position.clone(),t:controls.target.clone()};const x=KRAG.x,z=KRAG.z+30;
  tween={fp:camera.position.clone(),ft:controls.target.clone(),tp:new THREE.Vector3(x,groundHeight(x,z)+1.7,z),tt:new THREE.Vector3(x+20,groundHeight(x,z)+1.7,z),t:0,dur:2.2,done:()=>enterFP(x,z,-Math.PI/2)};};
document.getElementById('bLabels').onclick=()=>labelsOn=!labelsOn;
document.getElementById('bNight').onclick=()=>{mapNight=!mapNight;dayT=mapNight?.03:.42;};
window.addEventListener('resize',()=>{renderer.setSize(innerWidth,innerHeight);camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();resizeInspector();});
function updateLabels(){const show=labelsOn&&mode==='map';const el=document.getElementById('labels');el.style.display=show?'block':'none';if(!show)return;const v=new THREE.Vector3();
  const camD=camera.position.distanceTo(controls.target);
  for(const L of LABELS){v.copy(L.pos).project(camera);if(v.z>1||Math.abs(v.x)>1.05||Math.abs(v.y)>1.05){L.el.style.display='none';continue;}
    L.el.style.display='block';L.el.style.opacity=camD<160&&camera.position.distanceTo(L.pos)>900?.25:1;L.el.style.transform=`translate(${(v.x*.5+.5)*innerWidth}px,${(-v.y*.5+.5)*innerHeight}px) translate(-50%,-50%)`;}}

/* =====================================================================
   MAIN LOOP
   ===================================================================== */
const clock=new THREE.Clock();let clockT=0;
function loop(){requestAnimationFrame(loop);const dt=Math.min(.05,clock.getDelta());clockT+=dt;crossT-=dt;
  if(tween){tween.t+=dt/tween.dur;const k=ease(Math.min(1,tween.t));camera.position.lerpVectors(tween.fp,tween.tp,k);controls.target.lerpVectors(tween.ft,tween.tt,k);camera.lookAt(controls.target);
    if(tween.t>=1){const d=tween.done;tween=null;if(d)d();else controls.update();}}
  if(mode==='map'){if(!tween)controls.update();updateLabels();mapPick(dt);idleAnim(dt);applyLighting(dt);}
  else{regionId=biomeAt(player.pos.x,player.pos.z);
    if(!paused&&!dead&&!codexOpen){dayT=(dayT+dt/360)%1;updatePlayer(dt);updateWeapons(dt);updateEntities(dt);updateArrows(dt);fpPick(dt);}
    else{camera.rotation.set(player.pitch,player.yaw,0);}
    applyLighting(dt);horrorFX(dt);updateHUD();}
  renderer.render(scene,camera);if(codexOpen&&insp)renderInspector(dt);}

setTimeout(()=>{buildWorld();LOREPOS.rhoenmouth=P(828,187);buildLegend();applyLighting(1);document.getElementById('loading').style.display='none';loop();},50);
