<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Vùng Đất Cấm — The Forbidden Land</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,700;1,500&family=IBM+Plex+Mono:wght@400;600&display=swap&subset=vietnamese" rel="stylesheet">
<style>
:root{--ink:#0c0b0e;--panel:rgba(14,12,16,.88);--line:#3b3029;--text:#d9cfbd;--dim:#8f8576;--gold:#c9a55a;--blood:#b3352a;--ice:#9fc3d8;}
*{box-sizing:border-box}
html,body{margin:0;height:100%;overflow:hidden;background:#07070a;color:var(--text);font-family:'Cormorant Garamond',Georgia,serif}
#stage canvas{display:block}
.mono{font-family:'IBM Plex Mono',monospace}
button{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--text);background:#1a1519;border:1px solid var(--line);padding:7px 11px;cursor:pointer;letter-spacing:.04em}
button:hover{border-color:var(--gold);color:#fff}
#loading{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#060608;z-index:50;text-align:center}
#loading h1{font-size:54px;margin:0;letter-spacing:.08em;color:#e8dcc4}
#loading p{color:var(--dim);font-style:italic;margin:6px 0 0}
#topbar{position:fixed;top:0;left:0;right:0;display:flex;gap:10px;align-items:center;padding:10px 14px;background:linear-gradient(#000c,#0000);z-index:10;flex-wrap:wrap}
#topbar .title{font-size:24px;font-weight:700;letter-spacing:.06em;margin-right:10px}
#topbar .title small{font-size:14px;color:var(--dim);font-style:italic;font-weight:500;margin-left:6px}
#legend{position:fixed;left:14px;top:64px;width:250px;max-height:calc(100% - 140px);overflow:auto;background:var(--panel);border:1px solid var(--line);padding:10px 12px;z-index:9;font-size:15px}
#legend h3{margin:8px 0 2px;font-size:13px;font-family:'IBM Plex Mono',monospace;color:var(--gold);letter-spacing:.08em;text-transform:uppercase}
#legend .ri{display:flex;align-items:center;gap:7px;cursor:pointer;padding:1px 0}
#legend .ri:hover{color:#fff}
#legend .sw{width:11px;height:11px;border:1px solid #0008;flex:none}
#legend .note{color:var(--dim);font-size:13px;font-style:italic;margin-top:8px}
#mapHelp{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);font-size:12px;color:var(--dim);background:var(--panel);border:1px solid var(--line);padding:6px 12px;z-index:9;text-align:center;max-width:calc(100% - 32px)}
#labels{position:fixed;inset:0;pointer-events:none;z-index:5}
.lbl{position:absolute;left:0;top:0;font-size:15px;font-weight:700;color:#efe4cc;text-shadow:0 0 4px #000,0 0 8px #000;white-space:nowrap;letter-spacing:.05em}
.lbl.mono{font-size:10px;color:var(--gold);font-weight:400}
.lbl.margin{color:#ffd9f0;font-size:11px;font-style:italic}
#tag{position:fixed;z-index:20;display:none;background:#0d0b0fee;border:1px solid var(--gold);color:#f1e6cf;padding:4px 10px 5px;font-size:15px;cursor:pointer;white-space:nowrap;box-shadow:0 0 14px #000}
#tag:hover{background:#2a1d14;border-color:#e9c27a}
#tag small{color:var(--dim);font-family:'IBM Plex Mono',monospace;font-size:10px;margin-left:6px}
/* codex */
#codex{position:fixed;inset:0;background:#000b;z-index:40;display:none;align-items:center;justify-content:center;padding:16px}
#codex.open{display:flex}
.cx-card{position:relative;width:min(980px,100%);max-height:100%;overflow:auto;background:linear-gradient(#17131a,#0e0c10);border:1px solid #5a4630;box-shadow:0 0 60px #000,inset 0 0 80px #0008;padding:20px 22px}
.cx-card:before{content:"";position:absolute;inset:6px;border:1px solid #3a2e22;pointer-events:none}
#cx-close{position:absolute;right:14px;top:12px;z-index:2}
#cx-cls{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--blood);letter-spacing:.12em;text-transform:uppercase}
#cx-name{margin:2px 0 2px;font-size:34px;color:#f0e3c8;line-height:1.05}
#cx-sub{color:var(--dim);font-style:italic}
.cx-body{display:flex;gap:20px;margin-top:14px;flex-wrap:wrap}
.cx-view{flex:1 1 360px;min-width:260px;position:relative;border:1px solid var(--line);background:radial-gradient(#221c22,#08070a)}
#cx-canvas{width:100%;height:340px;display:block;cursor:grab}
.cx-hint{position:absolute;bottom:6px;left:8px;font-size:10px;color:var(--dim);font-family:'IBM Plex Mono',monospace}
.cx-text{flex:1 1 380px;font-size:17px;line-height:1.38}
.cx-text dl{display:grid;grid-template-columns:auto 1fr;gap:3px 12px;margin:0 0 10px;font-size:15px}
.cx-text dt{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--gold);text-transform:uppercase;letter-spacing:.06em;padding-top:3px}
.cx-text dd{margin:0}
.cx-text h4{margin:12px 0 2px;font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--gold);letter-spacing:.1em;text-transform:uppercase}
.cx-text p{margin:0}
#cx-counter{color:#e7d3a6}
.cx-actions{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}
/* HUD */
#hud{position:fixed;inset:0;pointer-events:none;z-index:8;display:none}
#cross{position:absolute;left:50%;top:50%;width:18px;height:18px;margin:-9px 0 0 -9px}
#cross:before,#cross:after{content:"";position:absolute;background:#e8dcc4b0}
#cross:before{left:8px;top:2px;width:2px;height:14px}#cross:after{top:8px;left:2px;height:2px;width:14px}
#cross.hit:before,#cross.hit:after{background:#ff4a3a}
#fptag{position:absolute;left:50%;top:calc(50% + 22px);transform:translateX(-50%);font-size:16px;color:#f0e5cc;text-shadow:0 0 5px #000;white-space:nowrap}
#fptag small{font-family:'IBM Plex Mono',monospace;color:var(--gold);font-size:11px}
#bars{position:absolute;left:18px;bottom:18px;width:240px;font-family:'IBM Plex Mono',monospace;font-size:10px}
.bar{height:9px;background:#0009;border:1px solid #fff2;margin:3px 0 7px}
.bar i{display:block;height:100%}
#hp i{background:#a8322a}#sn i{background:#6d63b8}#st i{background:#b8a36a}
#weap{position:absolute;right:18px;bottom:18px;display:flex;gap:8px;font-family:'IBM Plex Mono',monospace;font-size:12px}
#weap div{border:1px solid #fff3;padding:6px 10px;background:#0008}
#weap div.on{border-color:var(--gold);color:#fff}
#region{position:absolute;top:58px;left:50%;transform:translateX(-50%);text-align:center;text-shadow:0 0 6px #000}
#region b{font-size:26px;letter-spacing:.06em;display:block}
#region span{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--dim)}
#prompt{position:absolute;left:50%;bottom:90px;transform:translateX(-50%);font-family:'IBM Plex Mono',monospace;font-size:13px;color:#f3e7cd;text-shadow:0 0 4px #000}
#warn{position:absolute;left:50%;top:30%;transform:translateX(-50%);font-size:44px;font-weight:700;color:#e23b2e;letter-spacing:.12em;text-shadow:0 0 12px #f00a;opacity:0;white-space:nowrap}
#fpHelp{position:absolute;right:18px;top:60px;font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:#cfc4b0b0;text-align:right;line-height:1.6}
#vignette{position:absolute;inset:0;background:radial-gradient(ellipse at center,#0000 45%,#000 100%);opacity:.35}
#bloodv{position:absolute;inset:0;background:radial-gradient(ellipse at center,#0000 50%,#7a0000 120%);opacity:0}
#fx{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:7;image-rendering:pixelated;mix-blend-mode:screen;opacity:0}
#scan{position:fixed;inset:0;pointer-events:none;z-index:7;opacity:0;background:repeating-linear-gradient(0deg,#0000 0 2px,#0006 2px 3px)}
#vhs{position:fixed;left:24px;top:60px;z-index:8;font-family:'IBM Plex Mono',monospace;font-size:20px;color:#fff;text-shadow:2px 0 #f00,-2px 0 #0ff;opacity:0;pointer-events:none}
#pause,#death{position:fixed;inset:0;z-index:30;display:none;align-items:center;justify-content:center;flex-direction:column;background:#000a;text-align:center;padding:16px}
#pause h2,#death h2{font-size:40px;margin:0 0 6px}
#death h2{color:#c8392c}
#pause p,#death p{color:var(--dim);font-style:italic;margin:0 0 14px}
@media (max-width:700px){#legend{display:none}#topbar .title{font-size:18px}}
</style>
</head>
<body>
<div id="loading"><h1>Vùng Đất Cấm</h1><p>The Forbidden Land — carving the Wheel from a collapsed magma dome…</p></div>
<div id="stage"></div>
<div id="labels"></div>
<canvas id="fx" width="240" height="135"></canvas>
<div id="scan"></div>
<div id="vhs">▶ PLAY&nbsp;&nbsp;<span id="vhsT">00:00:00</span><br><small>TRACKING ERR</small></div>

<div id="topbar">
  <div class="title">Vùng Đất Cấm<small>The Forbidden Land · Atlas</small></div>
  <button id="bAtlas">⟲ Whole Wheel</button>
  <button id="bDescend">⇣ Descend at Kraghaven</button>
  <button id="bLabels">Labels [L]</button>
  <button id="bNight">Dusk / Day</button>
</div>
<div id="legend"></div>
<div id="mapHelp">Hover anything for its name · <b>click the name tag</b> to open the Lore Codex · drag rotate · right-drag pan · wheel zoom · double-click ground to descend</div>
<div id="tag"></div>

<div id="hud">
  <div id="vignette"></div><div id="bloodv"></div>
  <div id="region"><b id="regName">—</b><span id="regSub"></span></div>
  <div id="cross"></div><div id="fptag"></div>
  <div id="warn"></div>
  <div id="prompt"></div>
  <div id="bars">HEALTH<div class="bar" id="hp"><i></i></div>SANITY<div class="bar" id="sn"><i></i></div>STAMINA<div class="bar" id="st"><i></i></div><span id="clock"></span></div>
  <div id="weap"><div id="w1">[1] Iron Sword</div><div id="w2">[2] Hunting Bow</div></div>
  <div id="fpHelp">WASD move · Shift sprint · Space jump<br>LMB slash / hold-release to shoot<br>[1] sword [2] bow · [F] board/leave sampan<br>[E] codex of targeted thing · [N] pass time<br>[M] return to Atlas</div>
</div>
<div id="pause"><h2>Paused</h2><p>Click to return to the land · [M] Atlas</p><button id="bResume">Resume</button></div>
<div id="death"><h2 id="deathT">You were claimed.</h2><p id="deathP"></p><button id="bRespawn">Return to the Atlas</button></div>

<div id="codex"><div class="cx-card">
  <button id="cx-close">✕ Close</button>
  <div id="cx-cls"></div><h2 id="cx-name"></h2><div id="cx-sub"></div>
  <div class="cx-body">
    <div class="cx-view"><canvas id="cx-canvas"></canvas><div class="cx-hint">drag to rotate · wheel to zoom</div></div>
    <div class="cx-text">
      <dl><dt>Classification</dt><dd id="cx-c"></dd><dt>Ring / Sector</dt><dd id="cx-r"></dd><dt>Language Zone</dt><dd id="cx-l"></dd></dl>
      <p id="cx-desc"></p>
      <h4>Habits &amp; Rules</h4><p id="cx-habits"></p>
      <h4>Countermeasures</h4><p id="cx-counter"></p>
    </div>
  </div>
  <div class="cx-actions"><button id="cx-zoom">⌖ Zoom to region</button><button id="cx-descend">⇣ Descend here (first-person)</button></div>
</div></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script>
'use strict';
/* =====================================================================
   VÙNG ĐẤT CẤM — constants, noise, helpers
   ===================================================================== */
const DEG=Math.PI/180;
const RC=140,RI=350,RM=600,RO=900,RSTAR=1400,RMARG=1450,WORLD=1700;
const OUTER=['Gremvang','Kjølmyr','Hrimmark','Valen','Kessaren','Thalenis'];
const MIDDLE=['Dvelskarn','Nyrkvøld','Hjarnvang','Sarrobren','Halorren','Nerith'];
const INNER=['Hveskgruv','Iskhjarn','Thaal-Uresh','Vaar-Ithun','Kaurath','Ur-Keth'];
const ROMAN=['I','II','III','IV','V','VI','VII'];
const slug=s=>s.toLowerCase().replace(/ø/g,'o').replace(/[^a-z0-9]+/g,'-');
const OUTER_IDS=OUTER.map(slug),MIDDLE_IDS=MIDDLE.map(slug),INNER_IDS=INNER.map(slug);

function hash2(x,y){let h=(Math.imul(x|0,374761393)+Math.imul(y|0,668265263))|0;h=Math.imul(h^(h>>>13),1274126177);h^=h>>>16;return (h>>>0)/4294967296;}
function vnoise(x,y){const xi=Math.floor(x),yi=Math.floor(y),xf=x-xi,yf=y-yi,u=xf*xf*(3-2*xf),v=yf*yf*(3-2*yf);
  const a=hash2(xi,yi),b=hash2(xi+1,yi),c=hash2(xi,yi+1),d=hash2(xi+1,yi+1);return a+(b-a)*u+(c-a)*v+(a-b-c+d)*u*v;}
function fbm(x,y,o=4){let s=0,a=.5,f=1,n=0;for(let i=0;i<o;i++){s+=a*vnoise(x*f+i*17.3,y*f-i*9.1);n+=a;a*=.5;f*=2.03;}return s/n;}
let seed=7;function rnd(){seed=(seed*16807)%2147483647;return (seed-1)/2147483646;}
const rr=(a,b)=>a+rnd()*(b-a);
function smooth(e0,e1,x){const t=Math.min(1,Math.max(0,(x-e0)/(e1-e0)));return t*t*(3-2*t);}
function angOf(x,z){return ((Math.atan2(-z,x)/DEG)+360)%360;}
function P(r,a,y=0){return new THREE.Vector3(Math.cos(a*DEG)*r,y,-Math.sin(a*DEG)*r);}
function sectorIdx(a){return Math.floor(((((180-a)%360)+360)%360)/60)%6;}
function angDiff(a,b){return ((a-b)%360+540)%360-180;}
function ringOf(r){return r<RC?'caldera':r<RI?'inner':r<RM?'middle':r<RO?'outer':'beyond';}
const RINGTXT={outer:'Outer Ring · 0–400 m',middle:'Middle Ring · 400–2000 m',inner:'Inner Ring · 2000–5000 m',caldera:'Central Caldera · Ithuun',beyond:'Beyond the Fault Wall'};

function radialProfile(r){
  if(r>RO) return 3-Math.max(0,r-1520)*.03-Math.max(0,r-1660)*.4;
  if(r>RM) return 1+15*(RO-r)/(RO-RM);
  if(r>RI) return 18+62*(RM-r)/(RM-RI);
  if(r>RC) return 84+116*Math.pow((RI-r)/(RI-RC),1.15);
  return 125+75*smooth(.55,1,r/RC);
}
function ampOf(r){return r>RO?3:r>RM?3.5:r>RI?9:r>RC?16:4;}
function rawHeight(x,z,out){
  const r=Math.hypot(x,z),a=angOf(x,z);
  let h=radialProfile(r),amp=ampOf(r);
  const ring=ringOf(r),s=sectorIdx(a);
  if(ring==='middle'&&s===4)amp*=.25;
  if(ring==='inner'&&(s===2||s===4))amp*=1.45;
  h+=(fbm(x*.006+50,z*.006+50,5)-.5)*2*amp;
  let wall=0,dike=0;
  const dW=Math.abs(r-RO);
  if(dW<40){let g=1e9;for(let k=0;k<6;k++)g=Math.min(g,Math.abs(angDiff(a,k*60))*DEG*r);
    wall=(1-smooth(5,16,dW))*smooth(14,22,g);h+=34*wall;}
  if(r>RC-10&&r<RO){for(let k=0;k<6;k++){const d=angDiff(a,k*60);if(Math.abs(d)>30)continue;const pd=Math.abs(Math.sin(d*DEG))*r;
    if(pd<14){const gap=smooth(10,22,Math.abs(r-RM))*smooth(10,22,Math.abs(r-RI))*smooth(RC,RC+40,r)*(1-smooth(RO-70,RO-40,r));
      const f=(1-smooth(3,10,pd))*gap;dike=Math.max(dike,f);h+=26*f;}}}
  if(out){out.wall=wall;out.dike=dike;}
  return h;
}

/* ---------------- River Rhoenos ---------------- */
const RIVER_CTRL=[[250,148],[330,152],[420,158],[500,166],[545,180],[578,194],[650,192],[770,184],[900,180],[1050,178],[1250,176],[1450,174],[1700,172]];
const river=(()=>{const curve=new THREE.CatmullRomCurve3(RIVER_CTRL.map(([r,a])=>P(r,a)));
  const pts=curve.getSpacedPoints(500);let prev=1e9;
  return pts.map((p,i)=>{const r=Math.hypot(p.x,p.z);let h=radialProfile(r)-ampOf(r)-1.2;h=Math.min(h,prev);prev=h;
    return {x:p.x,z:p.z,w:5+9*(i/500),h};});})();
river.forEach((s,i)=>{const a=river[Math.max(0,i-1)],b=river[Math.min(river.length-1,i+1)];const dx=b.x-a.x,dz=b.z-a.z,l=Math.hypot(dx,dz)||1;s.tx=dx/l;s.tz=dz/l;});
function riverQuery(x,z){let best=1e18,bi=0;for(let i=0;i<river.length;i+=4){const s=river[i],d=(s.x-x)**2+(s.z-z)**2;if(d<best){best=d;bi=i;}}
  const lo=Math.max(0,bi-6),hi=Math.min(river.length-1,bi+6);for(let i=lo;i<=hi;i++){const s=river[i],d=(s.x-x)**2+(s.z-z)**2;if(d<best){best=d;bi=i;}}
  const s=river[bi];return {d:Math.sqrt(best),i:bi,w:s.w,h:s.h,tx:s.tx,tz:s.tz,s};}

/* ---------------- Biomes ---------------- */
function biomeAt(x,z){const r=Math.hypot(x,z);if(r<RC)return 'ithuun';const s=sectorIdx(angOf(x,z));
  if(r<RI)return INNER_IDS[s];if(r<RM)return MIDDLE_IDS[s];if(r<RO)return OUTER_IDS[s];
  if(r<RMARG)return 'outlands';const m=Math.floor((r-RMARG)/30);return m<7?'margin-'+(m+1):'void';}
const BIOME_DEF={};
[['outer',OUTER,['#8f7d3c','#4d574b','#a7b2b5','#5b7838','#77654c','#8a877c'],['rye','marsh','frost','meadow','reeds','shore']],
 ['middle',MIDDLE,['#4a4d55','#1e2a21','#6a6356','#977140','#d2ccbd','#33503e'],['quarry','forest','cairns','scrub','salt','fen']],
 ['inner',INNER,['#dde8f1','#b5cbdc','#2b1f1f','#5a4a6b','#7a3a25','#c6bca4'],['glacier','seracs','lava','ash','rust','bone']]]
.forEach(([ring,names,cols,props])=>names.forEach((n,i)=>{BIOME_DEF[slug(n)]={id:slug(n),name:n,ring,sector:i,color:cols[i],props:props[i]};}));
BIOME_DEF['ithuun']={id:'ithuun',name:'Ithuun',ring:'caldera',sector:-1,color:'#151019',props:'caldera'};
BIOME_DEF['outlands']={id:'outlands',name:'Ngoại Vực — The Star Moors',ring:'beyond',sector:-1,color:'#3f4537',props:'outlands'};
const PASTEL=['#f3c9dc','#c4e7f0','#d9cdf2','#cbeccf','#f3ebc0','#f2d4c4','#e8e8f6'];
for(let m=1;m<=7;m++)BIOME_DEF['margin-'+m]={id:'margin-'+m,name:'Lề '+ROMAN[m-1],ring:'beyond',sector:-1,color:PASTEL[m-1],props:'margin',m};
BIOME_DEF['void']={id:'void',name:'The White Beyond',ring:'beyond',sector:-1,color:'#eceaf0',props:'margin',m:8};
const BCOL={};for(const k in BIOME_DEF)BCOL[k]=new THREE.Color(BIOME_DEF[k].color);
function sectorCenter(i){return 150-60*i;}
function biomeCentroid(id){const b=BIOME_DEF[id];if(!b)return new THREE.Vector3();if(b.ring==='caldera')return new THREE.Vector3(0,groundHeight(0,0),0);
  if(b.ring==='beyond'){const r=b.m?RMARG+30*(b.m-1)+15:1200;const p=P(r,150);p.y=groundHeight(p.x,p.z);return p;}
  const r={outer:750,middle:475,inner:245}[b.ring];const p=P(r,sectorCenter(b.sector));p.y=groundHeight(p.x,p.z);return p;}

/* ---------------- Heightmap ---------------- */
const N=420,SIZE=WORLD*2,CELL=SIZE/N,HM=new Float32Array((N+1)*(N+1));
function groundHeight(x,z){let fx=(x+WORLD)/CELL,fz=(z+WORLD)/CELL;fx=Math.max(0,Math.min(N-.001,fx));fz=Math.max(0,Math.min(N-.001,fz));
  const i=Math.floor(fx),j=Math.floor(fz),u=fx-i,v=fz-j,W=N+1;
  const a=HM[j*W+i],b=HM[j*W+i+1],c=HM[(j+1)*W+i],d=HM[(j+1)*W+i+1];return a+(b-a)*u+(c-a)*v+(a-b-c+d)*u*v;}
function structAt(x,z){const o={};rawHeight(x,z,o);return o;}

/* =====================================================================
   RENDERER / SCENE
   ===================================================================== */
const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));renderer.setSize(innerWidth,innerHeight);
document.getElementById('stage').appendChild(renderer.domElement);
const scene=new THREE.Scene();scene.background=new THREE.Color(0x6b7380);
const camera=new THREE.PerspectiveCamera(50,innerWidth/innerHeight,1,9000);camera.position.set(0,1750,1550);scene.add(camera);
const controls=new THREE.OrbitControls(camera,renderer.domElement);
controls.target.set(0,60,0);controls.enableDamping=true;controls.dampingFactor=.08;controls.maxPolarAngle=1.38;controls.minDistance=25;controls.maxDistance=4200;
const hemi=new THREE.HemisphereLight(0xb8c4d0,0x2a2620,.6);scene.add(hemi);
const sun=new THREE.DirectionalLight(0xffe2c0,.9);scene.add(sun);scene.add(sun.target);
scene.fog=new THREE.Fog(0x6b7380,2600,7500);
const stars=(()=>{const g=new THREE.BufferGeometry(),a=[];for(let i=0;i<1800;i++){const u=rnd()*2-1,t=rnd()*Math.PI*2,s=Math.sqrt(1-u*u);a.push(s*Math.cos(t)*4000,Math.abs(u)*4000+200,s*Math.sin(t)*4000);}
