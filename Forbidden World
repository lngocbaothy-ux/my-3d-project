const raycaster=new THREE.Raycaster();raycaster.params.Line.threshold=3;raycaster.params.Points.threshold=2;
function marchTerrain(o,d,maxT){let t=0,prev=0,step=mode==='map'?5:1.2;
  for(;t<maxT;t+=step){const x=o.x+d.x*t,y=o.y+d.y*t,z=o.z+d.z*t;
    if(Math.abs(x)<WORLD&&Math.abs(z)<WORLD&&y<groundHeight(x,z)){let lo=prev,hi=t;for(let i=0;i<10;i++){const m=(lo+hi)/2;if(o.y+d.y*m<groundHeight(o.x+d.x*m,o.z+d.z*m))hi=m;else lo=m;}return hi;}
    prev=t;if(mode==='map')step=Math.max(4,t*.004);}return null;}
function visibleChain(o){while(o){if(!o.visible)return false;o=o.parent;}return true;}
function pickAt(ndc,maxT){raycaster.setFromCamera(ndc,camera);const o=raycaster.ray.origin,d=raycaster.ray.direction;
  const tt=marchTerrain(o,d,maxT);raycaster.far=tt!==null?tt+.5:maxT;
  const hits=raycaster.intersectObjects(pickables,true);for(const h of hits){if(visibleChain(h.object)&&h.object.userData.loreId)return {id:h.object.userData.loreId,point:h.point.clone()};}
  if(tt===null)return null;const p=o.clone().addScaledVector(d,tt);return {id:terrainIdAt(p.x,p.z),point:p};}
function terrainIdAt(x,z){const st=structAt(x,z);if(st.wall>.35)return 'faultwall';if(st.dike>.35)return 'dike';const r=Math.hypot(x,z);if(r>200){const q=riverQuery(x,z);if(q.d<q.w)return 'rhoenos';}return biomeAt(x,z);}
const tagEl=document.getElementById('tag');let tag={id:null,point:null,x:0,y:0,overTag:false,cand:null,candT:0,lastSeen:0};
const mouse={x:0,y:0,ndc:new THREE.Vector2(),moved:false,down:false};
renderer.domElement.addEventListener('pointermove',e=>{mouse.x=e.clientX;mouse.y=e.clientY;mouse.ndc.set(e.clientX/innerWidth*2-1,-e.clientY/innerHeight*2+1);mouse.moved=true;});
renderer.domElement.addEventListener('pointerdown',()=>{mouse.down=true;});window.addEventListener('pointerup',()=>{mouse.down=false;});
tagEl.addEventListener('mouseenter',()=>tag.overTag=true);tagEl.addEventListener('mouseleave',()=>tag.overTag=false);
tagEl.addEventListener('click',()=>{if(tag.id){openCodex(tag.id,tag.point);hideTag();}});
function hideTag(){tagEl.style.display='none';tag.id=null;tag.overTag=false;}
let pickClock=0;
function mapPick(dt){pickClock+=dt;if(tag.overTag||codexOpen||tween)return;if(mouse.down){hideTag();return;}
  if(pickClock<.09||!mouse.moved)return;pickClock=0;mouse.moved=false;
  const res=pickAt(mouse.ndc,9000);const now=performance.now();
  if(!res){if(now-tag.lastSeen>700)hideTag();return;}
  tag.lastSeen=now;
  if(res.id!==tag.cand){tag.cand=res.id;tag.candT=now;}
  const show=()=>{tag.id=res.id;tag.point=res.point;tag.x=mouse.x;tag.y=mouse.y;const L=LORE[res.id];tagEl.innerHTML=(L?L.name:res.id)+'<small>codex ›</small>';
    tagEl.style.display='block';tagEl.style.left=Math.min(innerWidth-tagEl.offsetWidth-6,mouse.x+8)+'px';tagEl.style.top=(mouse.y+8)+'px';};
  if(!tag.id||(res.id===tag.cand&&now-tag.candT>260&&res.id!==tag.id))show();
  else if(res.id===tag.id){tag.point=res.point;if(Math.hypot(mouse.x-tag.x,mouse.y-tag.y)>90)show();}}

