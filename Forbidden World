    case 'shore':R(()=>mesh(new THREE.SphereGeometry(.15+Math.random()*.15,5,4),M(0x9a978c),0,.05,0),70);{const b=mesh(new THREE.CylinderGeometry(.3,.7,1,10,1,true),M(0x6a5a38,{metalness:.7,side:THREE.DoubleSide}),1,.5,1);b.rotation.z=1.2;g.add(b);}break;
