function M(c,o={}){return new THREE.MeshStandardMaterial(Object.assign({color:c,roughness:.85,metalness:.05},o));}
function mesh(g,m,x=0,y=0,z=0){const o=new THREE.Mesh(g,m);o.position.set(x,y,z);return o;}
const mat4=(x,y,z,rx=0,ry=0,rz=0,s=1,sy)=>new THREE.Matrix4().compose(new THREE.Vector3(x,y,z),new THREE.Quaternion().setFromEuler(new THREE.Euler(rx,ry,rz)),new THREE.Vector3(s,sy===undefined?s:sy,s));
function mergeParts(parts){const pos=[],nor=[],col=[],c=new THREE.Color();
  for(const p of parts){let g=p.geo.index?p.geo.toNonIndexed():p.geo.clone();if(p.m)g.applyMatrix4(p.m);g.computeVertexNormals();
    const pa=g.attributes.position.array,na=g.attributes.normal.array;c.set(p.color);for(let i=0;i<pa.length;i++){pos.push(pa[i]);nor.push(na[i]);}for(let i=0;i<pa.length/3;i++)col.push(c.r,c.g,c.b);}
  const o=new THREE.BufferGeometry();o.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));o.setAttribute('normal',new THREE.Float32BufferAttribute(nor,3));o.setAttribute('color',new THREE.Float32BufferAttribute(col,3));return o;}

